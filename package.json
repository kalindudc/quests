{
  "name": "pi-quests",
  "version": "0.11.1",
  "description": "A quest-log for your pi. Keep your agent on track, one quest at a time.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "quests",
    "snapshot",
    "rollback",
    "todo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalindudc/quests.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.79"
  },
  "bb": {
    "name": "Quests",
    "description": "Manage each thread's quest log.",
    "branding": {
      "icon": "ListTodo"
    },
    "server": "./extensions/bb/server.ts",
    "app": "./extensions/bb/app.tsx",
    "skills": [
      "./src/skills"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/pi/index.ts"
    ]
  },
  "files": [
    "src/",
    "extensions/pi/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@get-bb/plugin-sdk": "0.6.79",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typebox": "^1.1.33",
    "typescript": "^6.0.3",
    "vaul": "^1.1.2",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "style": "biome check --error-on-warnings ./src ./test ./extensions",
    "style:fix": "biome check --write --unsafe --no-errors-on-unmatched --error-on-warnings ./src ./test ./extensions",
    "format": "biome format --write --no-errors-on-unmatched ./src ./test ./extensions",
    "prepublishOnly": "npx tsc --noEmit && npx vitest run",
    "prepare": "bash scripts/setup.sh",
    "cleanup": "bash scripts/cleanup.sh",
    "dev": "bash scripts/dev.sh",
    "logs": "bash scripts/logs.sh"
  }
}
